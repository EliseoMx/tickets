<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de IIS (solo HTTP) para usarlo como proxy inverso hacia Waitress.
  Copia este archivo a la carpeta física del sitio (o de la aplicación) en IIS.
  Requiere los módulos gratuitos de Microsoft "URL Rewrite" y "Application Request
  Routing" (ARR), con el proxy habilitado.

  - Ajusta el puerto (8000) si corriste waitress-serve con otro distinto.
  - La regla "StaticFiles" evita que /static se mande a Waitress: IIS lo sirve
    directo desde el directorio virtual "static" (ver README).
  - Si el sistema vive en una subruta (ej. /tickets), este mismo archivo va en la
    carpeta de la APLICACIÓN de IIS: las reglas ya son relativas a ella, así que IIS
    quita el prefijo solo. Ver README, sección "Publicar en una subruta".
  - Para HTTPS usa web.https.config en lugar de este archivo.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="StaticFiles" stopProcessing="true">
          <match url="^static/.*" />
          <action type="None" />
        </rule>
        <rule name="ReverseProxyToWaitress" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>

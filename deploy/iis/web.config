<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ejemplo de configuración de IIS para usarlo como proxy inverso hacia Waitress.
  Copia este archivo a la carpeta física del sitio en IIS (la que configures en
  "Agregar sitio web"). Requiere tener instalados los módulos gratuitos de
  Microsoft "Application Request Routing" (ARR) y "URL Rewrite".

  Ajusta el puerto (8000) si corriste waitress-serve con otro distinto.

  HTTPS: este archivo ya incluye (1) la redirección de http:// a https:// y
  (2) el encabezado X-Forwarded-Proto que le avisa a Django que la conexión
  original es segura. Para que (2) funcione, antes hay que permitir esa variable
  en IIS (una sola vez por servidor): IIS Manager > (nombre del servidor) >
  URL Rewrite > "View Server Variables..." > Add > HTTP_X_FORWARDED_PROTO.
  Sin ese paso, IIS responde "500.50". Solo úsalo con un certificado ya instalado
  y con el enlace https (443) creado; si aún no hay HTTPS, quita la regla
  "RedirectToHttps" y deja USE_HTTPS=False en el .env.

  Ver instrucciones completas en el README, sección "Despliegue en Windows con IIS".
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="RedirectToHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="ReverseProxyToWaitress" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Igual que web.config, pero con HTTPS: redirige http:// a https:// y le manda a
  Waitress el encabezado X-Forwarded-Proto para que Django sepa que la conexión
  original es segura. Úsalo (renombrado a web.config) solo cuando YA exista el
  certificado y el enlace https (443) en IIS.

  Requisito (una sola vez por servidor): permitir la variable de servidor en
  IIS Manager > (nombre del servidor) > URL Rewrite > "View Server Variables..." >
  Add > HTTP_X_FORWARDED_PROTO. Sin eso IIS responde "500.50".

  En el .env del servidor: USE_HTTPS=True, SITE_URL=https://tu-dominio y
  ALLOWED_HOSTS. Waitress debe arrancar con --trusted-proxy (ver README).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="RedirectToHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <!-- {REQUEST_URI} es la ruta completa original (incluye /tickets si es una subruta);
               {R:1} es relativo a la aplicación y perdería el prefijo. -->
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Found" appendQueryString="false" />
        </rule>
        <rule name="StaticFiles" stopProcessing="true">
          <match url="^static/.*" />
          <action type="None" />
        </rule>
        <rule name="ReverseProxyToWaitress" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
